<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pt.henrique</groupId>
    <artifactId>market</artifactId>
    <version>2.2.0</version>
    <packaging>jar</packaging>

    <name>Market</name>
    <description>A unified marketplace plugin with Server Shop, Community Market, and Auctions</description>

    <!--
      This branch (mc26) targets Minecraft 26.x only. Two builds from one source tree,
      selected by Maven profile, both compiled with JDK 25 (the 26.x API is class file 69
      and JDK 21 cannot read it):

        mc263 (default)  paper-api 26.3
        mc262            paper-api 26.2, and the one that runs the tests

      The 1.21.11 build lives on main. This line reads 26.x-only item components
      (sulfur cube contents), so it does not compile against 1.21.11.
      Bytecode is Java 21 in both jars. See BUILDING.md.
    -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.version>26.3.build.140-beta</paper.version>
        <paper.api.version>26.3</paper.api.version>
        <mc.target>mc26.3</mc.target>
    </properties>

    <profiles>
        <profile>
            <id>mc263</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <paper.version>26.3.build.140-beta</paper.version>
                <paper.api.version>26.3</paper.api.version>
                <mc.target>mc26.3</mc.target>
                <!-- MockBukkit has no 26.3 build yet; the mc262 profile runs the suite. -->
                <maven.test.skip>true</maven.test.skip>
            </properties>
        </profile>
        <profile>
            <id>mc262</id>
            <properties>
                <paper.version>26.2.build.112-stable</paper.version>
                <paper.api.version>26.2</paper.api.version>
                <mc.target>mc26.2</mc.target>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.mockbukkit.mockbukkit</groupId>
                    <artifactId>mockbukkit-v26.2</artifactId>
                    <version>4.116.1</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter</artifactId>
                    <version>6.0.3</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <repositories>
        <!-- Paper Repository -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>


        <!-- MultiBank API (compile-time only, provided at runtime by server) -->
        <dependency>
            <groupId>pt.henrique</groupId>
            <artifactId>multibank</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/MultiBank-1.0.0.jar</systemPath>
        </dependency>

        <!-- Vault support is handled via reflection at runtime (no compile-time dep needed) -->

        <!-- HikariCP for Database Connection Pooling -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- SQLite JDBC Driver -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>market-${project.version}+${mc.target}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>pt.henrique.market.libs.hikari</shadedPattern>
                                </relocation>
                            </relocations>
                            <minimizeJar>true</minimizeJar>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>pt.henrique:market</artifact>
                                    <includes>
                                        <include>**/*.class</include>
                                        <include>**/*.yml</include>
                                        <include>**/*.yaml</include>
                                        <include>**/*.properties</include>
                                        <include>plugin.yml</include>
                                        <include>config.yml</include>
                                        <include>prices.yml</include>
                                        <include>items.yml</include>
                                        <include>lang/**</include>
                                    </includes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Modrinth Publishing -->
            <plugin>
                <groupId>com.modrinth.minotaur</groupId>
                <artifactId>Minotaur</artifactId>
                <version>2.8.7</version>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

</project>